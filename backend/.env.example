# Copiar como backend/.env y completar. El archivo .env NO se sube al repositorio.

# PostgreSQL: local o Supabase (Project Settings > Database > Connection string > URI)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/salonflow

# Clave para firmar los JWT: mínimo 32 caracteres aleatorios.
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia-esta-clave-por-una-de-al-menos-32-caracteres

# Orígenes del frontend permitidos (separados por coma). En producción, la URL pública.
CORS_ORIGINS=http://localhost:5173

# Servicio de IA (carpeta ia/). En local corre en el puerto 8001.
IA_URL=http://127.0.0.1:8001
# Opcional: la misma clave que IA_API_KEY del servicio de IA (si se deja vacía, no se exige clave).
IA_API_KEY=
IA_TIMEOUT_SEGUNDOS=10

# Responsable del tratamiento de datos (Ley 1581): aparece en el aviso de privacidad.
RESPONSABLE_NOMBRE=SalonFlow (salón de demostración)
RESPONSABLE_CONTACTO=privacidad@salonflow.co
