# Variables del servicio de IA (definirlas en el sistema o en Render; este servicio no lee archivos .env).

# Opcional: si se define, POST /predecir exige el encabezado X-API-Key con este valor.
# Debe ser la misma que IA_API_KEY del backend.
IA_API_KEY=

# Opcional: ruta del modelo entrenado (por defecto, ia/modelo_riesgo.keras).
MODELO_PATH=
